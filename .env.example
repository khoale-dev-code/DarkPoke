# ===== Supabase (bắt buộc khi chạy thật) =====
# Lấy ở Supabase Dashboard > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Khóa service role: CHỈ dùng phía server (webhook ngân hàng, mời nhân viên, ảnh chuyển khoản). Không đưa lên client.
SUPABASE_SERVICE_ROLE_KEY=

# ===== Website =====
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ===== Webhook đối soát chuyển khoản (SePay, Casso hoặc tương tự) =====
# Chuỗi bí mật bạn tự đặt, dán cùng giá trị vào cấu hình webhook của dịch vụ
BANK_WEBHOOK_SECRET=

# ===== Cron tự hủy đơn quá hạn (Vercel Cron gửi kèm header Authorization: Bearer <CRON_SECRET>) =====
CRON_SECRET=

# Tên miền ảnh ngoài muốn tối ưu qua next/image, cách nhau dấu phẩy (không bắt buộc)
NEXT_PUBLIC_IMAGE_HOSTS=

# Bật sau khi muốn đo Analytics/Speed Insights trên Vercel (build lại sau khi đổi)
NEXT_PUBLIC_ENABLE_ANALYTICS=false

# ===== Thư viện thẻ: giá chi tiết Scrydex (không bắt buộc) =====
# Không điền thì trang chi tiết thẻ vẫn có giá TCGplayer (USD) và Cardmarket (EUR) lấy qua TCGdex.
# Điền đủ hai khóa để thêm giá theo tình trạng (NM/LP/MP/HP/DM), giá grading PSA/CGC/BGS, biến động và lịch sử 90 ngày.
# Lấy tại https://scrydex.com: tạo team trong Account Hub (Team ID), đăng ký gói rồi tạo API key. Mỗi request tốn API credit.
SCRYDEX_API_KEY=
SCRYDEX_TEAM_ID=
# Secret webhook (dạng whsec_...) khi đăng ký URL https://<tên-miền>/api/webhooks/scrydex trong Scrydex.
# Webhook làm mới đúng các bộ thẻ có giá thay đổi, thay vì gọi API liên tục.
SCRYDEX_WEBHOOK_SECRET=

# Nút chuyển giá sang VND dùng tỷ giá tự cập nhật hằng ngày (ExchangeRate-API, miễn phí, không cần khóa).
# Điền các biến dưới nếu muốn dùng tỷ giá của cửa hàng thay thế (không bắt buộc), ví dụ 26300
CARD_PRICE_USD_VND=
CARD_PRICE_EUR_VND=
CARD_PRICE_JPY_VND=
